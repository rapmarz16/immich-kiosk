package partials

import "github.com/damongolding/immich-kiosk/internal/common"

templ DaveningTimes(viewData common.ViewData) {
	if viewData.Zmanim.Enabled && (viewData.Zmanim.ShowSunTimes || viewData.Zmanim.ShowDaveningTimes) {
		<section id="davening-times" aria-label="Today's zmanim">
			<h2 class="davening-times__title">Today's Zmanim</h2>
			<dl class="davening-times__list">
				if viewData.Zmanim.ShowSunTimes {
					<div class="davening-times__row davening-times__row--neitz">
						<dt><span class="davening-times__icon" aria-hidden="true">🌄</span><span>Neitz</span></dt>
						<dd>{ viewData.ZmanimTimes.Sunrise }</dd>
					</div>
				}
				if viewData.Zmanim.ShowDaveningTimes {
					for _, entry := range viewData.ZmanimTimes.Davening {
						if entry.Label != "" && entry.Time != "" {
							<div class={ "davening-times__row " + daveningRowClass(entry.Label) }>
								<dt><span class="davening-times__icon" aria-hidden="true">{ daveningIcon(entry.Label) }</span><span>{ entry.Label }</span></dt>
								<dd>{ entry.Time }</dd>
							</div>
							if viewData.Zmanim.ShowSunTimes && isMincha(entry.Label) {
								<div class="davening-times__row davening-times__row--shkiah">
									<dt><span class="davening-times__icon" aria-hidden="true">🌇</span><span>Shkiah</span></dt>
									<dd>{ viewData.ZmanimTimes.Sunset }</dd>
								</div>
							}
						}
					}
				} else if viewData.Zmanim.ShowSunTimes {
					<div class="davening-times__row davening-times__row--shkiah">
						<dt><span class="davening-times__icon" aria-hidden="true">🌇</span><span>Shkiah</span></dt>
						<dd>{ viewData.ZmanimTimes.Sunset }</dd>
					</div>
				}
			</dl>
		</section>
	}
}
