package partials

templ DaveningTimes() {
	<section id="davening-times" aria-label="Today's zmanim">
		<h2 class="davening-times__title">Today's Zmanim</h2>
		<div class="davening-times__zmanim" aria-label="Zmanim">
			<div class="davening-times__row davening-times__row--neitz">
				<span class="davening-times__label"><span class="davening-times__icon" aria-hidden="true">🌄</span><span>Neitz</span></span>
				<span class="davening-times__time">5:31 AM</span>
			</div>
			<div class="davening-times__row davening-times__row--shkiah">
				<span class="davening-times__label"><span class="davening-times__icon" aria-hidden="true">🌇</span><span>Shkiah</span></span>
				<span class="davening-times__time">8:51 PM</span>
			</div>
		</div>
		<div class="davening-times__tefilos" aria-label="Tefilos">
			<div class="davening-times__tefila davening-times__row--morning">
				<span class="davening-times__icon" aria-hidden="true">🌅</span>
				<span class="davening-times__tefila-label">Shachris</span>
				<span class="davening-times__tefila-time">8:00 AM</span>
			</div>
			<div class="davening-times__tefila davening-times__row--afternoon">
				<span class="davening-times__icon" aria-hidden="true">☀️</span>
				<span class="davening-times__tefila-label">Mincha</span>
				<span class="davening-times__tefila-time">8:30 PM</span>
			</div>
			<div class="davening-times__tefila davening-times__row--night">
				<span class="davening-times__icon" aria-hidden="true">🌙</span>
				<span class="davening-times__tefila-label">Maariv</span>
				<span class="davening-times__tefila-time">9:00 PM</span>
			</div>
		</div>
	</section>
}
